// Cloudflare Workers Static Assets with no Worker script: Cloudflare serves
// the built files in dist/ directly. Deployed by CI with `wrangler deploy`.
{
  "name": "dswithx",
  "compatibility_date": "2026-10-29",
  // Serve only at dswithx.com, not also at *.workers.dev.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html, with a 404 status, for unknown paths.
    "not_found_handling": "404-page"
  },
  // Serve the site at the apex domain; Cloudflare creates the DNS record and
  // certificate. www.dswithx.com redirects here via a dashboard Redirect Rule.
  "routes": [{ "pattern": "dswithx.com", "custom_domain": true }]
}
