---
import { render } from 'astro:content';
import CodeBlock from './CodeBlock.astro';
import VariantBadges from './VariantBadges.astro';
import type { Implementation } from '../lib/repo';
import { LANGUAGE_GROUPS } from '../site';

interface Props {
  impls: Implementation[];
}

const { impls } = Astro.props;
const panels = await Promise.all(
  impls.map(async (impl) => ({
    impl,
    label: impl.language.data.name + (impl.meta.variant === 'built-in' ? ' (built-in)' : ''),
    Notes: impl.notes ? (await render(impl.notes)).Content : null,
  })),
);

// One tab per language. A language with a built-in variant gets a switch in
// its panels instead of a second tab; from-scratch comes first, so it opens
// by default.
const variantOrder = (impl: Implementation) => (impl.meta.variant === 'from-scratch' ? 0 : 1);
const languages = [...new Set(impls.map((i) => i.language.id))].map((id) => {
  const versions = panels
    .filter((p) => p.impl.language.id === id)
    .sort((a, b) => variantOrder(a.impl) - variantOrder(b.impl));
  return { id, name: versions[0].impl.language.data.name, versions };
});
const versionsOf = (id: string) => languages.find((l) => l.id === id)!.versions;

// Tabs in labeled rows. Within a row, tabs keep the order of impls.
const grouped = new Set(LANGUAGE_GROUPS.flatMap((g) => g.languages));
const rows = [
  ...LANGUAGE_GROUPS.map((g) => ({
    label: g.label,
    tabs: languages.filter((l) => g.languages.includes(l.id)),
  })),
  { label: 'Other', tabs: languages.filter((l) => !grouped.has(l.id)) },
].filter((row) => row.tabs.length > 0);
---

<div class="impl-tabs">
  <!-- Shown by the script below; without JavaScript every panel is listed in turn. -->
  <div class="tablist" role="tablist" aria-label="Implementations" hidden>
    {rows.map((row) => (
      <div class="tab-row" role="presentation">
        <span class="row-label" aria-hidden="true">{row.label}</span>
        <div class="row-tabs" role="presentation">
          {row.tabs.map(({ id, name, versions }) => (
            <button type="button" role="tab" id={`tab-${id}`} aria-controls={versions[0].impl.slug} data-lang={id}>
              {name}
            </button>
          ))}
        </div>
      </div>
    ))}
  </div>

  {panels.map(({ impl, label, Notes }) => {
    const versions = versionsOf(impl.language.id);
    return (
      <section
        class="panel"
        id={impl.slug}
        role="tabpanel"
        aria-labelledby={`tab-${impl.language.id}`}
        data-lang={impl.language.id}
      >
        <div class="panel-head">
          <h3>{label}</h3>
          {versions.length > 1 && (
            <div class="versions" role="group" aria-label={`${impl.language.data.name} version`} hidden>
              {versions.map((v) => (
                <button type="button" data-slug={v.impl.slug} aria-pressed={String(v.impl.slug === impl.slug)}>
                  {v.impl.meta.variant === 'built-in' ? 'Built-in' : 'From scratch'}
                </button>
              ))}
            </div>
          )}
          <VariantBadges meta={impl.meta} />
          <a class="lang-link" href={`/languages/${impl.language.id}/`}>{impl.language.data.toolchain}</a>
        </div>
        <CodeBlock
          code={impl.file.code}
          filename={impl.file.name}
          repoPath={impl.file.path}
          lang={impl.language.data.highlight}
        />
        {Notes && (
          <div class="notes">
            <Notes />
          </div>
        )}
      </section>
    );
  })}
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.impl-tabs')) {
    const tablist = root.querySelector<HTMLElement>('[role=tablist]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    // The version last shown for each language, so switching languages and
    // back keeps the reader's choice.
    const shown = new Map<string, string>();

    const select = (slug: string, focus = false) => {
      const lang = panels.find((p) => p.id === slug)!.dataset.lang!;
      shown.set(lang, slug);
      tabs.forEach((tab) => {
        const active = tab.dataset.lang === lang;
        tab.setAttribute('aria-selected', String(active));
        if (active) tab.setAttribute('aria-controls', slug);
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel) => (panel.hidden = panel.id !== slug));
    };
    // Update the shareable #<slug> link without jumping the page.
    const choose = (slug: string) => {
      select(slug);
      history.replaceState(null, '', `#${slug}`);
    };
    const fromHash = () => {
      const slug = decodeURIComponent(location.hash.slice(1));
      return panels.some((p) => p.id === slug) ? slug : null;
    };

    tablist.hidden = false;
    root.classList.add('enhanced');
    root.querySelectorAll<HTMLElement>('.versions').forEach((group) => (group.hidden = false));
    select(fromHash() ?? panels[0].id);

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        const lang = tab.dataset.lang!;
        choose(shown.get(lang) ?? panels.find((p) => p.dataset.lang === lang)!.id);
      });
      tab.addEventListener('keydown', (event) => {
        const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
        if (!step) return;
        const next = tabs[(i + step + tabs.length) % tabs.length];
        next.click();
        next.focus();
      });
    });
    root.querySelectorAll<HTMLButtonElement>('.versions button').forEach((button) => {
      button.addEventListener('click', () => {
        choose(button.dataset.slug!);
        // The clicked button's twin in the newly shown panel keeps focus.
        root.querySelector<HTMLButtonElement>(`#${button.dataset.slug} .versions [aria-pressed=true]`)?.focus();
      });
    });
    window.addEventListener('hashchange', () => {
      const slug = fromHash();
      if (slug) select(slug);
    });
  }
</script>

<style>
  .tablist {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.5rem 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1rem;
  }
  /* Each row's label and buttons sit in the tablist's two columns. */
  .tab-row { display: contents; }
  .row-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    padding-top: 0.45rem;
  }
  .row-tabs { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  [role='tab'] {
    font: inherit;
    font-size: 0.9rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    cursor: pointer;
  }
  [role='tab']:hover { border-color: var(--accent); }
  [role='tab'][aria-selected='true'] {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: var(--accent);
    font-weight: 600;
  }
  /* On narrow screens each label sits above its buttons. */
  @media (max-width: 600px) {
    .tablist { grid-template-columns: 1fr; gap: 0.25rem; }
    .row-label { padding-top: 0.5rem; }
  }
  /* A segmented switch between a language's from-scratch and built-in versions. */
  .versions {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
  }
  .versions button {
    font: inherit;
    font-size: 0.8rem;
    color: var(--muted);
    background: var(--surface);
    border: 0;
    padding: 0.2rem 0.7rem;
    cursor: pointer;
  }
  .versions button + button { border-left: 1px solid var(--border); }
  .versions button:hover { color: var(--text); }
  .versions button[aria-pressed='true'] {
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }
  /* The switch already says which version this is. */
  .enhanced .panel-head:has(.versions) :global(.badge.variant) { display: none; }
  .panel + .panel { margin-top: 2.5rem; }
  .enhanced .panel + .panel { margin-top: 0; }
  .panel { scroll-margin-top: 1rem; }
  .panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .panel-head h3 { margin: 0 0.25rem 0 0; }
  .enhanced .panel-head h3 { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .lang-link { margin-left: auto; font-size: 0.85rem; }
  .notes { margin-top: 1rem; }
</style>
